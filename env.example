# AlgoTrading MVP - Environment Configuration Example
# Copy this file to .env and update values for your environment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="AlgoTrading MVP"
APP_VERSION="1.0.0"
APP_DESCRIPTION="Algorithmic Trading System MVP"
DEBUG=false

# =============================================================================
# API SETTINGS
# =============================================================================
API_V1_PREFIX="/api/v1"
SECRET_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://algotrading:algotrading@localhost:5432/algotrading"
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# =============================================================================
# DATA ENGINE SETTINGS (Módulo 1)
# =============================================================================
# Cache Configuration
DATA_ENGINE_CACHE_ENABLED=true
DATA_ENGINE_CACHE_REDIS_ENABLED=true
DATA_ENGINE_CACHE_POSTGRES_ENABLED=true
DATA_ENGINE_CACHE_DEFAULT_TTL=3600  # 1 hour in seconds
DATA_ENGINE_CACHE_REDIS_URL="${REDIS_URL}"  # Uses REDIS_URL if not specified
DATA_ENGINE_CACHE_POSTGRES_URL="${DATABASE_URL}"  # Uses DATABASE_URL if not specified

# Streaming Configuration
DATA_ENGINE_STREAMING_ENABLED=false
DATA_ENGINE_STREAMING_HEARTBEAT_INTERVAL=30  # seconds
DATA_ENGINE_STREAMING_MAX_CONNECTIONS=100

# =============================================================================
# REDIS SETTINGS
# =============================================================================
# Redis URL for caching and session storage
REDIS_URL="redis://localhost:6379/0"
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# =============================================================================
# CELERY SETTINGS
# =============================================================================
# Celery broker and result backend URLs
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"
CELERY_TASK_SERIALIZER="json"
CELERY_RESULT_SERIALIZER="json"
CELERY_ACCEPT_CONTENT="json"

# =============================================================================
# TRADING API KEYS
# =============================================================================
# Interactive Brokers API (for paper trading and live trading)
IB_API_KEY=""
IB_SECRET=""

# Binance API (for cryptocurrency trading)
BINANCE_API_KEY=""
BINANCE_SECRET=""

# Alpha Vantage API (for market data)
ALPHA_VANTAGE_API_KEY=""

# =============================================================================
# TRADING SETTINGS
# =============================================================================
DEFAULT_CURRENCY="USD"
MAX_POSITION_SIZE=10000.0
RISK_FREE_RATE=0.02

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
LOG_LEVEL="INFO"
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_FILE=""

# =============================================================================
# CORS SETTINGS
# =============================================================================
# CORS allowed origins (comma-separated)
CORS_ORIGINS="*"
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS="*"
CORS_ALLOW_HEADERS="*"

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Uncomment and modify for development
# DEBUG=true
# LOG_LEVEL="DEBUG"
# DATABASE_ECHO=true

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# Uncomment and modify for production
# DEBUG=false
# LOG_LEVEL="WARNING"
# SECRET_KEY="your-production-secret-key-here-minimum-32-characters-long"
# DATABASE_URL="postgresql://user:pass@prod-db:5432/algotrading"
# REDIS_URL="redis://prod-redis:6379/0"

# =============================================================================
# SECURITY NOTES
# =============================================================================
# IMPORTANT: SECRET_KEY is REQUIRED in production (DEBUG=false)
# - Must be at least 32 characters long
# - Use a cryptographically secure random string
# - Never commit real secrets to version control
# - Use environment variables or secure secret management
