[flake8]
max-line-length = 100
extend-ignore = E203, W503, W504, E501, E402, B024, E704
extend-immutable-calls =
    Depends,
    Query,
    Path,
    Security,
    Body,
    Field,
    Form,
    Header,
    Cookie,
    File
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    .eggs,
    *.egg,
    dist,
    build,
    migrations,
per-file-ignores =
    __init__.py: F401
