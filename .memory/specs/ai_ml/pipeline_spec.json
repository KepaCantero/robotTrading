{
  "llm_usage": {
    "provider": "OpenAI",
    "model": "gpt-4",
    "fallback_model": "gpt-3.5-turbo",
    "prompt_templates": {
      "sentiment_analysis": {
        "template": "Analyze the sentiment of the following financial news text and return a score between -1 (very negative) and +1 (very positive). Text: {text}",
        "expected_response": {
          "sentiment_score": "float -1 to 1",
          "confidence": "float 0 to 1",
          "reasoning": "string",
          "key_factors": ["string"]
        }
      },
      "market_analysis": {
        "template": "Analyze the following market data and provide insights on potential trading opportunities. Data: {market_data}",
        "expected_response": {
          "analysis": "string",
          "opportunities": ["string"],
          "risks": ["string"],
          "recommendation": "string"
        }
      },
      "risk_assessment": {
        "template": "Assess the risk level of the following trading scenario. Scenario: {scenario}",
        "expected_response": {
          "risk_level": "LOW/MEDIUM/HIGH",
          "risk_score": "float 0 to 1",
          "risk_factors": ["string"],
          "mitigation_strategies": ["string"]
        }
      }
    },
    "rate_limits": {
      "requests_per_minute": 60,
      "tokens_per_minute": 150000,
      "requests_per_day": 10000,
      "tokens_per_day": 1000000
    },
    "cost_estimation": {
      "gpt_4": {
        "input_cost_per_1k_tokens": 0.03,
        "output_cost_per_1k_tokens": 0.06
      },
      "gpt_3_5_turbo": {
        "input_cost_per_1k_tokens": 0.001,
        "output_cost_per_1k_tokens": 0.002
      }
    }
  },
  "ml_training_pipeline": {
    "features": [
      {
        "name": "price_features",
        "description": "OHLCV data and derived price features",
        "types": [
          "open",
          "high",
          "low",
          "close",
          "volume",
          "returns",
          "volatility"
        ]
      },
      {
        "name": "volume_features",
        "description": "Volume-based features and indicators",
        "types": [
          "volume_sma",
          "volume_ratio",
          "volume_profile",
          "volume_weighted_price"
        ]
      },
      {
        "name": "technical_indicators",
        "description": "Technical analysis indicators",
        "types": ["rsi", "macd", "bollinger_bands", "stochastic", "williams_r"]
      },
      {
        "name": "market_microstructure",
        "description": "Market microstructure features",
        "types": [
          "bid_ask_spread",
          "order_book_imbalance",
          "trade_size",
          "trade_frequency"
        ]
      },
      {
        "name": "sentiment_features",
        "description": "Sentiment analysis features",
        "types": [
          "news_sentiment",
          "social_sentiment",
          "fear_greed_index",
          "vix"
        ]
      }
    ],
    "labels": {
      "primary": "price_direction_1h",
      "secondary": "price_direction_4h",
      "tertiary": "price_direction_1d",
      "description": "Price direction prediction (1 for up, 0 for down)"
    },
    "retrain_frequency": "weekly",
    "validation_splits": {
      "train": 0.7,
      "validation": 0.15,
      "test": 0.15
    },
    "drift_detection_metrics": [
      "accuracy_drop",
      "feature_distribution_shift",
      "prediction_distribution_shift",
      "concept_drift"
    ],
    "drift_thresholds": {
      "accuracy_drop": 0.05,
      "feature_shift": 0.1,
      "prediction_shift": 0.1,
      "concept_drift": 0.15
    }
  },
  "model_registry": {
    "schema": {
      "id": "string",
      "name": "string",
      "version": "semver",
      "type": "classification/regression",
      "metrics": {
        "accuracy": "float",
        "precision": "float",
        "recall": "float",
        "f1_score": "float",
        "sharpe_ratio": "float",
        "max_drawdown": "float"
      },
      "s3_path": "string",
      "approved_flag": "boolean",
      "created_at": "datetime",
      "deployed_at": "datetime",
      "retired_at": "datetime",
      "created_by": "string",
      "approved_by": "string"
    },
    "model_types": [
      "random_forest",
      "xgboost",
      "neural_network",
      "ensemble",
      "transformer"
    ],
    "approval_process": {
      "steps": [
        "model_validation",
        "backtesting",
        "stress_testing",
        "risk_assessment",
        "business_approval"
      ],
      "approvers": ["data_scientist", "risk_manager", "business_owner"],
      "approval_criteria": {
        "min_accuracy": 0.6,
        "min_sharpe_ratio": 1.0,
        "max_drawdown": 0.15
      }
    }
  },
  "explainability": {
    "requirements": "SHAP_values",
    "methods": [
      "shap",
      "lime",
      "feature_importance",
      "partial_dependence_plots"
    ],
    "feature_importance": {
      "storage_path": "s3://algotrading-models/explainability/",
      "format": "json",
      "retention_days": 365
    },
    "explanation_requirements": {
      "feature_importance_threshold": 0.01,
      "explanation_depth": "top_10_features",
      "explanation_format": "human_readable"
    }
  },
  "model_monitoring": {
    "performance_metrics": [
      "accuracy",
      "precision",
      "recall",
      "f1_score",
      "auc_roc",
      "log_loss"
    ],
    "drift_detection": {
      "methods": [
        "ks_test",
        "wasserstein_distance",
        "jensen_shannon_divergence"
      ],
      "frequency": "daily",
      "alert_threshold": 0.1
    },
    "alerting": {
      "channels": ["email", "slack", "pagerduty"],
      "severity_levels": ["low", "medium", "high", "critical"],
      "escalation_rules": {
        "low": ["email"],
        "medium": ["email", "slack"],
        "high": ["email", "slack", "pagerduty"],
        "critical": ["email", "slack", "pagerduty", "sms"]
      }
    }
  },
  "training_infrastructure": {
    "compute": {
      "instance_type": "ml.m5.xlarge",
      "max_runtime_hours": 24,
      "auto_scaling": true
    },
    "storage": {
      "training_data": "s3://algotrading-data/training/",
      "model_artifacts": "s3://algotrading-models/artifacts/",
      "experiment_logs": "s3://algotrading-models/experiments/"
    },
    "experiment_tracking": {
      "tool": "mlflow",
      "tracking_uri": "http://mlflow-server:5000",
      "experiment_name": "algotrading-models"
    }
  }
}
