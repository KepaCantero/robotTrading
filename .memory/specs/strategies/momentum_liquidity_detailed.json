{
  "strategy_name": "MomentumLiquidityStrategy",
  "strategy_type": "hybrid",
  "asset_classes": ["equity", "crypto", "forex"],
  "timeframes": ["1m", "5m", "15m"],
  "input_features": [
    {
      "name": "1m_OHLCV",
      "description": "1-minute OHLCV data",
      "required": true,
      "lookback_periods": 100
    },
    {
      "name": "5m_EMA_20",
      "description": "5-minute EMA with 20-period",
      "required": true,
      "lookback_periods": 50
    },
    {
      "name": "14_period_RSI",
      "description": "14-period RSI indicator",
      "required": true,
      "lookback_periods": 30
    },
    {
      "name": "volume_sma_20",
      "description": "20-period volume SMA",
      "required": true,
      "lookback_periods": 30
    },
    {
      "name": "bid_ask_spread",
      "description": "Current bid-ask spread",
      "required": true,
      "lookback_periods": 10
    },
    {
      "name": "market_depth",
      "description": "Order book depth (L2)",
      "required": false,
      "lookback_periods": 5
    },
    {
      "name": "volatility_20",
      "description": "20-period volatility",
      "required": true,
      "lookback_periods": 30
    }
  ],
  "output": {
    "signal": {
      "type": "enum",
      "values": ["BUY", "SELL", "HOLD"],
      "default": "HOLD"
    },
    "confidence": {
      "type": "float",
      "range": [0.0, 1.0],
      "default": 0.5
    },
    "position_size": {
      "type": "float",
      "calculation": "base_size * confidence * volatility_adjustment",
      "default": 100
    },
    "stop_loss": {
      "type": "float",
      "calculation": "entry_price * (1 - stop_loss_pct)",
      "default": 0.02
    },
    "take_profit": {
      "type": "float",
      "calculation": "entry_price * (1 + take_profit_pct)",
      "default": 0.04
    },
    "risk_score": {
      "type": "float",
      "range": [0.0, 1.0],
      "calculation": "volatility * position_size / account_balance"
    }
  },
  "hyperparameters": {
    "rsi_oversold": {
      "default": 30,
      "range": [20, 40],
      "description": "RSI level considered oversold"
    },
    "rsi_overbought": {
      "default": 70,
      "range": [60, 80],
      "description": "RSI level considered overbought"
    },
    "ema_period": {
      "default": 20,
      "range": [10, 50],
      "description": "EMA period for trend detection"
    },
    "volume_threshold": {
      "default": 1.5,
      "range": [1.0, 3.0],
      "description": "Volume multiplier for liquidity confirmation"
    },
    "spread_threshold": {
      "default": 0.001,
      "range": [0.0001, 0.01],
      "description": "Maximum bid-ask spread for entry"
    },
    "volatility_threshold": {
      "default": 0.02,
      "range": [0.01, 0.05],
      "description": "Maximum volatility for position sizing"
    },
    "momentum_strength": {
      "default": 0.6,
      "range": [0.3, 0.9],
      "description": "Minimum momentum strength for signal"
    },
    "liquidity_strength": {
      "default": 0.7,
      "range": [0.4, 0.9],
      "description": "Minimum liquidity strength for signal"
    }
  },
  "signal_logic": {
    "buy_conditions": [
      "rsi < rsi_oversold",
      "price > ema_20",
      "volume > volume_sma_20 * volume_threshold",
      "spread < spread_threshold",
      "momentum_strength > momentum_threshold",
      "liquidity_strength > liquidity_threshold"
    ],
    "sell_conditions": [
      "rsi > rsi_overbought",
      "price < ema_20",
      "volume > volume_sma_20 * volume_threshold",
      "spread < spread_threshold",
      "momentum_strength < -momentum_threshold",
      "liquidity_strength > liquidity_threshold"
    ],
    "hold_conditions": [
      "rsi between rsi_oversold and rsi_overbought",
      "spread > spread_threshold",
      "momentum_strength < momentum_threshold",
      "liquidity_strength < liquidity_threshold"
    ]
  },
  "position_sizing": {
    "base_size": {
      "equity": 100,
      "crypto": 0.001,
      "forex": 10000
    },
    "size_adjustments": {
      "volatility_adjustment": "1 / (1 + volatility)",
      "confidence_adjustment": "confidence_score",
      "account_balance_adjustment": "min(1.0, account_balance / 100000)"
    },
    "risk_limits": {
      "max_position_size_pct": 0.1,
      "max_daily_risk_pct": 0.02,
      "max_correlation_exposure": 0.3
    }
  },
  "transaction_cost_model": {
    "equity": {
      "slippage": 0.001,
      "commission": 0.005,
      "market_impact": 0.0005,
      "total_cost": "slippage + commission + market_impact"
    },
    "crypto": {
      "slippage": 0.0005,
      "commission": 0.001,
      "market_impact": 0.0002,
      "total_cost": "slippage + commission + market_impact"
    },
    "forex": {
      "slippage": 0.0001,
      "commission": 0.0002,
      "market_impact": 0.00005,
      "total_cost": "slippage + commission + market_impact"
    }
  },
  "backtest_assumptions": {
    "lookahead_bias": false,
    "survivorship_bias": "handled_with_delisting_data",
    "fees": "included_in_transaction_cost_model",
    "slippage": "realistic_based_on_volume",
    "market_impact": "estimated_based_on_order_size",
    "data_quality": "adjusted_for_splits_and_dividends"
  },
  "evaluation_metrics": {
    "sharpe_ratio": {
      "target": 1.5,
      "calculation": "excess_return / volatility",
      "benchmark": "risk_free_rate"
    },
    "sortino_ratio": {
      "target": 2.0,
      "calculation": "excess_return / downside_deviation",
      "benchmark": "risk_free_rate"
    },
    "max_drawdown": {
      "target": 0.15,
      "calculation": "max(peak - trough) / peak",
      "benchmark": "15%"
    },
    "calmar_ratio": {
      "target": 1.0,
      "calculation": "annual_return / max_drawdown",
      "benchmark": "1.0"
    },
    "win_rate": {
      "target": 0.55,
      "calculation": "winning_trades / total_trades",
      "benchmark": "55%"
    },
    "profit_factor": {
      "target": 1.5,
      "calculation": "gross_profit / gross_loss",
      "benchmark": "1.5"
    },
    "average_trade": {
      "target": 0.01,
      "calculation": "total_pnl / total_trades",
      "benchmark": "1%"
    }
  },
  "risk_management": {
    "stop_loss": {
      "type": "trailing",
      "initial_pct": 0.02,
      "trail_pct": 0.01,
      "max_loss_pct": 0.05
    },
    "take_profit": {
      "type": "fixed",
      "target_pct": 0.04,
      "partial_exit_pct": 0.5
    },
    "position_limits": {
      "max_positions": 10,
      "max_correlation": 0.7,
      "max_sector_exposure": 0.3
    }
  },
  "optimization": {
    "parameters_to_optimize": [
      "rsi_oversold",
      "rsi_overbought",
      "ema_period",
      "volume_threshold",
      "spread_threshold"
    ],
    "optimization_method": "genetic_algorithm",
    "optimization_period": "monthly",
    "walk_forward_analysis": true,
    "out_of_sample_testing": true
  }
}
