  "exposure_limits": {
    "daily_loss_limit": {
      "value": 0.05,
      "type": "percentage",
      "description": "Maximum daily loss as percentage of account balance"
    },
    "max_drawdown_limit": {
      "value": 0.15,
      "type": "percentage",
      "description": "Maximum drawdown before trading halt"
    },
    "single_trade_risk_pct": {
      "value": 0.02,
      "type": "percentage",
      "description": "Maximum risk per single trade"
    },
    "correlation_limit": {
      "value": 0.7,
      "type": "correlation_coefficient",
      "description": "Maximum correlation between positions"
    },
    "sector_exposure_limit": {
      "value": 0.3,
      "type": "percentage",
      "description": "Maximum exposure to any single sector"
    },
    "geographic_exposure_limit": {
      "value": 0.5,
      "type": "percentage",
      "description": "Maximum exposure to any single geographic region"
    }
  },
  "circuit_breaker_rules": {
    "thresholds": {
      "daily_loss": {
        "value": 0.03,
        "type": "percentage",
        "action": "halt_trading"
      },
      "drawdown": {
        "value": 0.1,
        "type": "percentage",
        "action": "reduce_position_sizes"
      },
      "volatility": {
        "value": 0.05,
        "type": "percentage",
        "action": "switch_to_conservative"
      },
      "error_rate": {
        "value": 0.05,
        "type": "percentage",
        "action": "halt_trading"
      },
      "latency": {
        "value": 1000,
        "type": "milliseconds",
        "action": "switch_to_backup_feed"
      }
    },
    "actions": {
      "halt_trading": {
        "description": "Immediately stop all trading activities",
        "duration": "until_manual_reset",
        "notifications": ["email", "slack", "sms"]
      },
      "reduce_position_sizes": {
        "description": "Reduce all position sizes by 50%",
        "duration": "until_conditions_improve",
        "notifications": ["email", "slack"]
      },
      "switch_to_conservative": {
        "description": "Switch to conservative strategy parameters",
        "duration": "until_volatility_normalizes",
        "notifications": ["email"]
      },
      "switch_to_backup_feed": {
        "description": "Switch to backup market data provider",
        "duration": "until_primary_feed_restored",
        "notifications": ["slack"]
      }
    }
  },
  "audit_log_retention": {
    "retention_days": 2555,
    "description": "7 years retention for regulatory compliance",
    "anonymization_rules": {
      "gdpr_compliant": true,
      "anonymize_after_days": 365,
      "pseudonymization": true,
      "encryption": "AES_256"
    },
    "log_categories": [
      "trade_execution",
      "order_placement",
      "strategy_decisions",
      "risk_checks",
      "system_events",
      "user_actions"
    ]
  },
  "regulatory_reports": {
    "mifid_ii_fields": [
      "transaction_id",
      "instrument_id",
      "price",
      "quantity",
      "side",
      "execution_timestamp",
      "venue",
      "buyer_id",
      "seller_id",
      "currency",
      "commission",
      "fees"
    ],
    "report_frequency": {
      "daily": "end_of_day",
      "weekly": "end_of_week",
      "monthly": "end_of_month"
    },
    "report_formats": ["XML", "JSON", "CSV"],
    "submission_deadlines": {
      "daily": "T+1",
      "weekly": "T+3",
      "monthly": "T+5"
    }
  },
  "model_validation": {
    "sr_11_7_checklist": [
      {
        "item": "model_documentation",
        "required": true,
        "description": "Complete model documentation including assumptions and limitations"
      },
      {
        "item": "performance_validation",
        "required": true,
        "description": "Validation of model performance against historical data"
      },
      {
        "item": "backtesting_results",
        "required": true,
        "description": "Comprehensive backtesting with out-of-sample testing"
      },
      {
        "item": "stress_testing",
        "required": true,
        "description": "Stress testing under various market conditions"
      },
      {
        "item": "model_governance",
        "required": true,
        "description": "Model governance framework and approval process"
      },
      {
        "item": "ongoing_monitoring",
        "required": true,
        "description": "Ongoing monitoring of model performance and drift detection"
      }
    ],
    "validation_frequency": {
      "initial": "before_deployment",
      "ongoing": "monthly",
      "comprehensive": "quarterly"
    },
    "validation_metrics": [
      "accuracy",
      "precision",
      "recall",
      "f1_score",
      "sharpe_ratio",
      "max_drawdown"
    ]
  },
  "compliance_monitoring": {
    "real_time_checks": [
      "position_limits",
      "exposure_limits",
      "correlation_limits",
      "risk_limits"
    ],
    "daily_checks": [
      "daily_pnl",
      "drawdown_calculation",
      "regulatory_reporting",
      "audit_log_completeness"
    ],
    "weekly_checks": [
      "model_performance",
      "strategy_performance",
      "risk_metrics",
      "compliance_status"
    ],
    "monthly_checks": [
      "model_validation",
      "stress_testing",
      "regulatory_compliance",
      "audit_review"
    ]
  }
}
