{
  "market_data_providers": {
    "primary_providers": [
      {
        "name": "Interactive Brokers",
        "type": "equity_forex",
        "latency": "50-100ms",
        "coverage": ["US Equities", "Forex", "Futures", "Options"],
        "api_type": "FIX/REST",
        "rate_limits": {
          "market_data": "300/minute",
          "orders": "60/minute"
        },
        "cost": "Variable based on data packages",
        "reliability": "99.9%",
        "implementation": "ib_insync library"
      },
      {
        "name": "Binance",
        "type": "cryptocurrency",
        "latency": "10-50ms",
        "coverage": ["Spot", "Futures", "Options"],
        "api_type": "REST/WebSocket",
        "rate_limits": {
          "market_data": "1200/minute",
          "orders": "1200/minute"
        },
        "cost": "Free for basic data",
        "reliability": "99.95%",
        "implementation": "ccxt library"
      },
      {
        "name": "Polygon",
        "type": "equity_data",
        "latency": "50-200ms",
        "coverage": ["US Equities", "Options", "Forex"],
        "api_type": "REST/WebSocket",
        "rate_limits": {
          "market_data": "5/minute (free)",
          "orders": "N/A"
        },
        "cost": "$199/month for real-time",
        "reliability": "99.8%",
        "implementation": "requests/websockets"
      }
    ],
    "secondary_providers": [
      {
        "name": "Alpha Vantage",
        "type": "equity_forex",
        "latency": "1-5 seconds",
        "coverage": ["Global Equities", "Forex", "Crypto"],
        "api_type": "REST",
        "rate_limits": {
          "market_data": "25/day (free)",
          "orders": "N/A"
        },
        "cost": "$25/month for premium",
        "reliability": "99.5%",
        "implementation": "alpha_vantage library"
      },
      {
        "name": "Yahoo Finance",
        "type": "equity_data",
        "latency": "1-10 seconds",
        "coverage": ["Global Equities", "ETFs", "Indices"],
        "api_type": "REST",
        "rate_limits": {
          "market_data": "2000/hour",
          "orders": "N/A"
        },
        "cost": "Free",
        "reliability": "99.0%",
        "implementation": "yfinance library"
      }
    ]
  },
  "data_feed_architecture": {
    "real_time_feeds": {
      "websocket_connections": {
        "ibkr": {
          "endpoint": "wss://api.ibkr.com/v1/ws",
          "subscriptions": [
            "market_data",
            "order_updates",
            "portfolio_updates"
          ],
          "reconnect_logic": "exponential_backoff",
          "max_reconnects": 10
        },
        "binance": {
          "endpoint": "wss://stream.binance.com:9443/ws",
          "subscriptions": ["ticker", "depth", "trades"],
          "reconnect_logic": "immediate",
          "max_reconnects": 5
        },
        "polygon": {
          "endpoint": "wss://socket.polygon.io/stocks",
          "subscriptions": ["trades", "quotes", "aggregates"],
          "reconnect_logic": "linear_backoff",
          "max_reconnects": 8
        }
      },
      "rest_endpoints": {
        "historical_data": {
          "ibkr": "/v1/api/marketdata/history",
          "binance": "/api/v3/klines",
          "polygon": "/v2/aggs/ticker/{ticker}/range/{multiplier}/{timespan}/{from}/{to}"
        },
        "current_data": {
          "ibkr": "/v1/api/marketdata/{symbol}",
          "binance": "/api/v3/ticker/price",
          "polygon": "/v2/snapshot/locale/us/markets/stocks/tickers/{ticker}"
        }
      }
    },
    "data_normalization": {
      "tick_format": {
        "symbol": "string",
        "timestamp": "datetime_utc",
        "bid": "float",
        "ask": "float",
        "last": "float",
        "volume": "int",
        "exchange": "string",
        "source": "string",
        "latency_ms": "int"
      },
      "normalization_rules": {
        "timestamp": "convert_to_utc",
        "price": "round_to_8_decimals",
        "volume": "integer_only",
        "symbol": "uppercase_standardize"
      }
    },
    "fallback_strategy": {
      "primary": "Interactive Brokers",
      "secondary": "Binance",
      "tertiary": "Polygon",
      "quaternary": "Alpha Vantage",
      "cached_snapshot": "Redis",
      "fallback_conditions": [
        "latency > 200ms",
        "error_rate > 5%",
        "connection_failure",
        "rate_limit_exceeded"
      ],
      "fallback_actions": [
        "switch_to_next_provider",
        "use_cached_data",
        "reduce_update_frequency",
        "alert_operations_team"
      ]
    }
  },
  "data_storage": {
    "real_time_cache": {
      "provider": "Redis",
      "ttl_seconds": 60,
      "max_memory_mb": 512,
      "eviction_policy": "allkeys-lru"
    },
    "historical_storage": {
      "provider": "PostgreSQL",
      "retention_days": 365,
      "partitioning": "daily",
      "compression": "pg_compression"
    },
    "backup_storage": {
      "provider": "AWS S3",
      "retention_days": 2555,
      "compression": "gzip",
      "encryption": "AES-256"
    }
  },
  "quality_metrics": {
    "latency_targets": {
      "equity": 50,
      "crypto": 100,
      "forex": 200
    },
    "availability_targets": {
      "uptime_percentage": 99.9,
      "max_downtime_minutes": 43.8
    },
    "data_quality_checks": [
      "price_reasonableness",
      "volume_validation",
      "timestamp_consistency",
      "symbol_validation"
    ]
  }
}
