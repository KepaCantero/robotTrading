{
  "provider_name": "InteractiveBrokers",
  "api_type": "FIX/REST",
  "base_url": "https://api.ibkr.com/v1",
  "sandbox_url": "https://api.ibkr.com/v1/sandbox",
  "endpoints": [
    {
      "name": "placeOrder",
      "method": "POST",
      "path": "/orders",
      "params": ["symbol", "qty", "price", "side", "orderType", "timeInForce"],
      "response_schema": {
        "order_id": "string",
        "status": "string",
        "filled_qty": "number",
        "avg_fill_price": "number",
        "commission": "number"
      },
      "example_request": {
        "symbol": "AAPL",
        "qty": 100,
        "price": 150.0,
        "side": "BUY",
        "orderType": "LMT",
        "timeInForce": "DAY"
      }
    },
    {
      "name": "cancelOrder",
      "method": "DELETE",
      "path": "/orders/{order_id}",
      "params": ["order_id"],
      "response_schema": {
        "order_id": "string",
        "status": "CANCELLED",
        "cancelled_at": "datetime"
      }
    },
    {
      "name": "getOrderStatus",
      "method": "GET",
      "path": "/orders/{order_id}",
      "params": ["order_id"],
      "response_schema": {
        "order_id": "string",
        "status": "string",
        "symbol": "string",
        "qty": "number",
        "filled_qty": "number",
        "avg_fill_price": "number",
        "commission": "number",
        "created_at": "datetime",
        "updated_at": "datetime"
      }
    },
    {
      "name": "marketData",
      "method": "GET",
      "path": "/marketdata/{symbol}",
      "params": ["symbol"],
      "response_schema": {
        "symbol": "string",
        "bid": "number",
        "ask": "number",
        "last": "number",
        "volume": "number",
        "timestamp": "datetime"
      }
    },
    {
      "name": "getPositions",
      "method": "GET",
      "path": "/positions",
      "params": [],
      "response_schema": {
        "positions": [
          {
            "symbol": "string",
            "qty": "number",
            "avg_cost": "number",
            "market_value": "number",
            "unrealized_pnl": "number"
          }
        ]
      }
    }
  ],
  "rate_limits": {
    "placeOrder": { "per_minute": 60, "per_second": 1 },
    "cancelOrder": { "per_minute": 30, "per_second": 0.5 },
    "getOrderStatus": { "per_minute": 120, "per_second": 2 },
    "marketData": { "per_minute": 300, "per_second": 5 },
    "getPositions": { "per_minute": 60, "per_second": 1 }
  },
  "authentication": {
    "type": "API_KEY",
    "header": "X-API-Key",
    "sandbox_credentials": {
      "api_key": "sandbox_api_key_placeholder",
      "api_secret": "sandbox_api_secret_placeholder"
    }
  },
  "error_handling": {
    "retry_pattern": "exponential_backoff",
    "max_retries": 3,
    "backoff_factor": 2,
    "idempotency_keys": true,
    "status_codes": {
      "200": "success",
      "400": "bad_request",
      "401": "unauthorized",
      "403": "forbidden",
      "404": "not_found",
      "429": "rate_limit_exceeded",
      "500": "internal_server_error",
      "502": "bad_gateway",
      "503": "service_unavailable"
    },
    "error_responses": {
      "400": {
        "code": "INVALID_REQUEST",
        "message": "Invalid request parameters",
        "details": "string"
      },
      "401": {
        "code": "UNAUTHORIZED",
        "message": "Invalid API key",
        "details": "string"
      },
      "429": {
        "code": "RATE_LIMIT",
        "message": "Rate limit exceeded",
        "retry_after": "seconds"
      }
    }
  },
  "sandbox_instructions": "Use sandbox endpoint with test credentials. All orders are simulated. Market data is delayed by 15 minutes.",
  "notes": "Interactive Brokers API requires account approval and paper trading setup before live trading access."
}
