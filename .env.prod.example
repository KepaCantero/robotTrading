# ============================================================================
# AlgoTrading - Production Environment Configuration
# ============================================================================
# Copy this file to .env.prod and fill in your actual production credentials
# DO NOT commit .env.prod to version control!

# ============================================================================
# Environment
# ============================================================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=postgresql://algotrading:STRONG_PASSWORD_HERE@localhost:5432/algotrading_prod
DB_HOST=localhost
DB_PORT=5432
DB_NAME=algotrading_prod
DB_USER=algotrading
DB_PASSWORD=STRONG_PASSWORD_HERE
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE
REDIS_MAX_CONNECTIONS=20

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
SECRET_KEY=YOUR_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG_CHANGE_THIS
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# Interactive Brokers Configuration (Production)
# ============================================================================
IB_PORT=7497
IB_HOST=127.0.0.1
IB_CLIENT_ID=1
IB_ACCOUNT=YOUR_IB_ACCOUNT_NUMBER
IB_PAPER_TRADING=false

# ============================================================================
# Alpaca Configuration (Production)
# ============================================================================
ALPACA_API_KEY=your_production_alpaca_api_key_here
ALPACA_SECRET_KEY=your_production_alpaca_secret_key_here
ALPACA_BASE_URL=https://api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# ============================================================================
# Market Data Configuration
# ============================================================================
POLYGON_API_KEY=your_polygon_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
MARKETAUX_API_KEY=your_marketaux_api_key_here

# ============================================================================
# News & Sentiment Configuration
# ============================================================================
NEWS_API_KEY=your_news_api_key_here
NEWS_WEBHOOK_URL=https://your-domain.com/api/news/webhook

# ============================================================================
# Alert Configuration
# ============================================================================
ALERT_EMAIL=your-email@example.com
ALERT_WEBHOOK_URL=https://your-domain.com/api/alerts/webhook
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ============================================================================
# SMTP Configuration (Email Alerts)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_EMAIL=your-email@example.com

# ============================================================================
# Trading Configuration (Production)
# ============================================================================
DEFAULT_INITIAL_CAPITAL=100000
DEFAULT_COMMISSION_PER_TRADE=1.0
DEFAULT_SLIPPAGE_PERCENTAGE=0.1

# Risk Management (Production - Conservative)
RISK_PER_TRADE_PERCENT=2.0
RISK_REWARD_RATIO=3.0
MAX_POSITION_SIZE_PERCENT=10.0
MAX_DRAWDOWN_LIMIT_PERCENT=15.0

# ============================================================================
# Strategy Configuration (Production)
# ============================================================================
DEFAULT_STOP_LOSS_PERCENT=5.0
DEFAULT_TAKE_PROFIT_PERCENT=15.0
DEFAULT_TRAILING_STOP_PERCENT=3.0

# ============================================================================
# Monitoring Configuration
# ============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
ALERTS_ENABLED=true

# ============================================================================
# Security Configuration
# ============================================================================
ENCRYPTION_KEY=your-32-character-encryption-key-here-change-this

# ============================================================================
# Logging Configuration (Production)
# ============================================================================
LOG_FILE_PATH=/var/log/algotrading/production.log
LOG_LEVEL=INFO
LOG_DATABASE_ENABLED=true

# ============================================================================
# Dashboard Configuration
# ============================================================================
DASHBOARD_HOST=localhost
DASHBOARD_PORT=8501
DASHBOARD_AUTO_RELOAD=false

# ============================================================================
# Circuit Breaker Configuration
# ============================================================================
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_LEVEL_1_THRESHOLD=-0.07
CIRCUIT_BREAKER_LEVEL_2_THRESHOLD=-0.13
CIRCUIT_BREAKER_LEVEL_3_THRESHOLD=-0.20

# ============================================================================
# Tax Compliance (Spain)
# ============================================================================
TAX_RESIDENCE_COUNTRY=ES
FIFO_ENABLED=true
MODELO_721_ENABLED=true
