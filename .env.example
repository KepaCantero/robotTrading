# ============================================================================
# AlgoTrading - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual API keys and credentials
#
# RULE 28 COMPLIANCE: SECURITY AND SECRETS MANAGEMENT
# ============================================================================
# This file contains all environment variables required by the application.
# NEVER commit the actual .env file to version control.
# NEVER share your .env file or expose secrets in logs.
#
# Quick Start:
#   1. Copy this file: cp .env.example .env
#   2. Generate SECRET_KEY: python -c 'import secrets; print(secrets.token_urlsafe(32))'
#   3. Fill in required API keys and passwords
#   4. Run validation: python scripts/validate_security.py
#
# ============================================================================

# ============================================================================
# ENVIRONMENT CONFIGURATION
# ============================================================================
ENVIRONMENT=development
DEBUG=True
TESTING=False

# ============================================================================
# SECURITY - REQUIRED (Rule 28)
# ============================================================================
# Main secret key for JWT tokens and encryption
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=your_generated_secret_key_minimum_32_characters_here

# Allow weak secret key in development (NEVER set to true in production)
ALLOW_WEAK_SECRET_KEY=false

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# DATABASE CONFIGURATION (Rule 28: Never hardcode credentials)
# ============================================================================
# Database URL (full connection string)
# Format: postgresql://user:password@host:port/database
# Or set individual components below
DATABASE_URL=sqlite:///./data/algo_trading.db

# Individual database components (used if DATABASE_URL not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=algotrading
DB_USER=postgres
DB_PASSWORD=your_secure_database_password_here

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ============================================================================
# QUESTDB CONFIGURATION (Metrics Storage)
# ============================================================================
QUESTDB_HOST=localhost
QUESTDB_PORT=9009
QUESTDB_DATABASE=qdb
QUESTDB_USER=admin
QUESTDB_PASSWORD=your_questdb_password_here

# ============================================================================
# REDIS CONFIGURATION (Optional - Caching)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password_here

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
LOG_LEVEL=INFO

# ============================================================================
# INTERACTIVE BROKERS CONFIGURATION
# ============================================================================
IB_PORT=7497
IB_HOST=127.0.0.1
IB_CLIENT_ID=1
IB_ACCOUNT=DU9811225
IB_PAPER_TRADING=True

# ============================================================================
# ALPACA CONFIGURATION (Paper Trading)
# ============================================================================
# Get your keys from: https://alpaca.markets/
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# ============================================================================
# MARKET DATA API KEYS (Rule 28: Use environment variables)
# ============================================================================

# Polygon.io - Real-time market data
# Get your key from: https://polygon.io/
POLYGON_API_KEY=your_polygon_api_key_here

# Alpha Vantage - Free tier available
# Get your key from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Yahoo Finance - Free, 15-min delay (no API key required)
YAHOO_FINANCE_ENABLED=True

# Financial Modeling Prep - Fundamental data
# Get your key from: https://site.financialmodelingprep.com/
FMP_API_KEY=your_fmp_api_key_here

# ============================================================================
# NEWS & SENTIMENT API KEYS (Optional)
# ============================================================================

# News API - Sentiment analysis
# Get your key from: https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# Marketaux - News sentiment
MARKETAUX_API_KEY=your_marketaux_api_key_here

# Twitter/X API - Sentiment analysis
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Reddit API - Sentiment analysis
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# ============================================================================
# NOTIFICATION CONFIGURATION (Optional)
# ============================================================================

# Email notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
NOTIFICATION_EMAIL=your_email@gmail.com

# Telegram notifications
# Get bot token from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ============================================================================
# NEO4J CONFIGURATION (Knowledge Graph - Optional)
# ============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ============================================================================
# TRADING CONFIGURATION
# ============================================================================
DEFAULT_INITIAL_CAPITAL=100000
DEFAULT_COMMISSION_PER_TRADE=1.0
DEFAULT_SLIPPAGE_PERCENTAGE=0.1

# Risk Management Defaults
RISK_PER_TRADE_PERCENT=2.0
RISK_REWARD_RATIO=3.0
MAX_POSITION_SIZE_PERCENT=10.0
MAX_DRAWDOWN_LIMIT_PERCENT=15.0

# ============================================================================
# BACKTESTING CONFIGURATION
# ============================================================================
BACKTESTING_INITIAL_CAPITAL=10000
BACKTESTING_COMMISSION_PER_TRADE=1.0
BACKTESTING_SLIPPAGE_PERCENTAGE=0.1
BACKTESTING_MAX_POSITION_SIZE=0.1

# ============================================================================
# PAPER TRADING CONFIGURATION
# ============================================================================
PAPER_TRADING_INITIAL_CAPITAL=100000
PAPER_TRADING_COMMISSION_PER_TRADE=1.0
PAPER_TRADING_SLIPPAGE_PERCENTAGE=0.1
PAPER_TRADING_ENABLED=True

# ============================================================================
# STRATEGY CONFIGURATION
# ============================================================================
DEFAULT_STOP_LOSS_PERCENT=5.0
DEFAULT_TAKE_PROFIT_PERCENT=15.0
DEFAULT_TRAILING_STOP_PERCENT=3.0

# ============================================================================
# DASHBOARD CONFIGURATION
# ============================================================================
DASHBOARD_HOST=localhost
DASHBOARD_PORT=8501
DASHBOARD_AUTO_RELOAD=True

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_FILE_PATH=logs/algo_trading.log
LOG_LEVEL=INFO
LOG_DATABASE_ENABLED=True

# ============================================================================
# EXTERNAL INTEGRATIONS (Optional)
# ============================================================================

# MLflow - Experiment tracking
MLFLOW_HOST=localhost
MLFLOW_PORT=5000

# Dagster - Pipeline orchestration
DAGSTER_HOST=localhost
DAGSTER_PORT=3000

# ============================================================================
# DEVELOPMENT/DEBUG CONFIGURATION
# ============================================================================
# WARNING: Never set DEBUG=True in production
DEBUG=False
TESTING=False
MOCK_DATA_ENABLED=False

# ============================================================================
# SECURITY VALIDATION
# ============================================================================
# Run security validation: python scripts/validate_security.py
# This will check:
# - All required secrets are configured
# - No weak/default passwords
# - Secret key length requirements
# - Production-readiness checks
