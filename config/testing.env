# Testing Environment Configuration
# TASK-5: Configuración de variables de entorno

# Environment
ENVIRONMENT=testing
DEBUG=true
APP_NAME=AlgoTrading
APP_VERSION=1.0.0

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=algotrading_test
DB_USER=postgres
DB_PASSWORD=password
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_SSL_MODE=prefer

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_MAX_CONNECTIONS=2
REDIS_SOCKET_TIMEOUT=5
REDIS_SSL=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001
API_WORKERS=1
SECRET_KEY=test-secret-key-for-testing-only-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_DAYS=1
CORS_ORIGINS=["*"]
CORS_METHODS=["*"]
CORS_HEADERS=["*"]
RATE_LIMIT_REQUESTS=10000
RATE_LIMIT_WINDOW=60

# Trading Configuration
DEFAULT_STRATEGY=momentum
MAX_POSITION_SIZE=0.05
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.05
STOP_LOSS_PERCENTAGE=0.01
TAKE_PROFIT_PERCENTAGE=0.02
POSITION_SIZING_METHOD=fixed
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_RATE_LIMIT=10000
BROKER_NAME=paper
BROKER_API_KEY=
BROKER_SECRET_KEY=
BROKER_SANDBOX=true

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE_ENABLED=false
LOG_FILE_PATH=logs/test.log
LOG_FILE_MAX_SIZE=1048576
LOG_FILE_BACKUP_COUNT=2
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_LEVEL=DEBUG
ELK_ENABLED=false
ELK_HOST=localhost
ELK_PORT=9200
ELK_INDEX=algotrading-test

# Monitoring Configuration
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9091
PROMETHEUS_PATH=/metrics
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=10
ALERTS_ENABLED=false
ALERTS_WEBHOOK_URL=
ALERTS_EMAIL=
