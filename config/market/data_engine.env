# Data Engine Configuration (Módulo 1)
# Añadir estas variables al archivo .env o centralized.env

# Cache Configuration
DATA_ENGINE_CACHE_ENABLED=true
DATA_ENGINE_CACHE_REDIS_ENABLED=true
DATA_ENGINE_CACHE_POSTGRES_ENABLED=true
DATA_ENGINE_CACHE_DEFAULT_TTL=3600  # 1 hour in seconds
# DATA_ENGINE_CACHE_REDIS_URL="redis://localhost:6379/0"  # Override REDIS_URL if needed
# DATA_ENGINE_CACHE_POSTGRES_URL="postgresql://user:pass@host:port/db"  # Override DATABASE_URL if needed

# Streaming Configuration
DATA_ENGINE_STREAMING_ENABLED=false
DATA_ENGINE_STREAMING_HEARTBEAT_INTERVAL=30  # seconds
DATA_ENGINE_STREAMING_MAX_CONNECTIONS=100

# Notas:
# - Si DATA_ENGINE_CACHE_REDIS_URL no está especificado, usa REDIS_URL
# - Si DATA_ENGINE_CACHE_POSTGRES_URL no está especificado, usa DATABASE_URL
# - Si Redis/PostgreSQL no están disponibles, el sistema usa cache en memoria automáticamente

