# Staging Environment Configuration
# TASK-5: Configuración de variables de entorno

# Environment
ENVIRONMENT=staging
DEBUG=false
APP_NAME=AlgoTrading
APP_VERSION=1.0.0

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=algotrading_staging
DB_USER=postgres
DB_PASSWORD=staging_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=30
DB_SSL_MODE=prefer

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=staging_redis_password
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5
REDIS_SSL=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
SECRET_KEY=staging-secret-key-change-in-production-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=3
CORS_ORIGINS=["https://staging.yourdomain.com"]
CORS_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_HEADERS=["Content-Type", "Authorization"]
RATE_LIMIT_REQUESTS=500
RATE_LIMIT_WINDOW=60

# Trading Configuration
DEFAULT_STRATEGY=momentum
MAX_POSITION_SIZE=0.08
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.08
STOP_LOSS_PERCENTAGE=0.02
TAKE_PROFIT_PERCENTAGE=0.04
POSITION_SIZING_METHOD=fixed
MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_API_KEY=staging_market_data_key
MARKET_DATA_RATE_LIMIT=500
BROKER_NAME=paper
BROKER_API_KEY=staging_broker_key
BROKER_SECRET_KEY=staging_broker_secret
BROKER_SANDBOX=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/staging.log
LOG_FILE_MAX_SIZE=10485760
LOG_FILE_BACKUP_COUNT=5
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_LEVEL=INFO
ELK_ENABLED=true
ELK_HOST=elasticsearch-staging
ELK_PORT=9200
ELK_INDEX=algotrading-staging

# Monitoring Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_PATH=/metrics
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
ALERTS_ENABLED=true
ALERTS_WEBHOOK_URL=https://hooks.slack.com/services/STAGING/SLACK/WEBHOOK
ALERTS_EMAIL=staging-alerts@yourdomain.com
