# Example secrets configuration
# Copy to secrets.yaml and fill in real values
# IMPORTANT: Add secrets.yaml to .gitignore and never commit it!

# ============================================================================
# API Keys
# ============================================================================
marketaux_api_key: "your_marketaux_api_key_here"
alpaca_api_key: "your_alpaca_api_key_here"
alpaca_secret_key: "your_alpaca_secret_key_here"
ibkr_client_id: "your_ibkr_client_id"
ibkr_client_secret: "your_ibkr_client_secret"

# ============================================================================
# Webhook URLs
# ============================================================================
news_webhook_url: "https://your-domain.com/api/news/webhook"
alert_webhook_url: "https://your-domain.com/api/alerts/webhook"

# ============================================================================
# Email alerts
# ============================================================================
alert_email: "your-email@example.com"

# ============================================================================
# Encryption
# ============================================================================
encryption_key: "your-32-character-encryption-key-here-change-this"
