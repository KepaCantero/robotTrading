# Global Configuration for Development Environment
# TASK-10: Centralización de Configuración

# Environment
ENVIRONMENT=development
DEBUG=true

# Trading Thresholds
MIN_SIGNAL_STRENGTH=60.0
MIN_SIGNAL_CONFIDENCE=70.0
MIN_LIQUIDITY_SCORE=50.0

# RSI Thresholds
RSI_OVERSOLD=30.0
RSI_OVERBOUGHT=70.0

# Position Sizing
MAX_POSITION_SIZE=0.1
MIN_POSITION_SIZE=0.01

# Risk Management
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.15
DAILY_LOSS_LIMIT=0.05
MAX_DRAWDOWN_LIMIT=0.15

# Exposure Limits
MAX_TOTAL_EXPOSURE=0.8
MAX_SECTOR_EXPOSURE=0.3
MAX_CORRELATION=0.7

# Circuit Breaker Thresholds
CIRCUIT_BREAKER_DAILY_LOSS=0.03
CIRCUIT_BREAKER_DRAWDOWN=0.1
CIRCUIT_BREAKER_VOLATILITY=0.05
CIRCUIT_BREAKER_ERROR_RATE=0.05

# Latency Thresholds
MAX_LATENCY_MS=1000
MAX_EXECUTION_TIME_MS=500

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=algotrading_dev
DB_USER=postgres
DB_PASSWORD=password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_SSL_MODE=prefer

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_PER_MINUTE=100

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_METHODS=["GET", "POST", "PUT", "DELETE"]

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FILE=logs/algotrading_dev.log
LOG_MAX_FILE_SIZE=10485760
LOG_BACKUP_COUNT=5

# ELK Stack Configuration
ELK_ENABLED=false
ELK_HOST=localhost
ELK_PORT=9200
ELK_INDEX=algotrading-dev-logs

# Monitoring Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3000
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# Alerting Configuration
ALERTS_ENABLED=true
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
