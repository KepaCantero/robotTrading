# Centralized Configuration Environment Variables
# TASK-10: Centralización de Configuración

# Environment
ENVIRONMENT=development
DEBUG=false

# Trading Thresholds
MIN_SIGNAL_STRENGTH=60.0
MIN_SIGNAL_CONFIDENCE=70.0
MIN_LIQUIDITY_SCORE=50.0
RSI_OVERSOLD=30.0
RSI_OVERBOUGHT=70.0
MAX_POSITION_SIZE=0.1
MIN_POSITION_SIZE=0.01
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.15
DAILY_LOSS_LIMIT=0.05
MAX_DRAWDOWN_LIMIT=0.15
MAX_TOTAL_EXPOSURE=0.8
MAX_SECTOR_EXPOSURE=0.3
MAX_CORRELATION=0.7

# Circuit Breakers
CIRCUIT_BREAKER_DAILY_LOSS=0.03
CIRCUIT_BREAKER_DRAWDOWN=0.1
CIRCUIT_BREAKER_VOLATILITY=0.05
CIRCUIT_BREAKER_ERROR_RATE=0.05

# Performance Thresholds
MAX_LATENCY_MS=1000
MAX_EXECUTION_TIME_MS=500

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=algotrading
DB_USER=postgres
DB_PASSWORD=password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_SSL_MODE=prefer

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_SECRET_KEY=your-secret-key-change-in-production
API_ACCESS_TOKEN_EXPIRE_MINUTES=30
API_RATE_LIMIT_PER_MINUTE=100

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/app.log
LOG_FILE_MAX_SIZE=10485760
LOG_FILE_BACKUP_COUNT=5
LOG_CONSOLE_ENABLED=true
LOG_ELK_ENABLED=false
LOG_ELK_HOST=localhost
LOG_ELK_PORT=9200
LOG_ELK_INDEX=algotrading

# Monitoring Configuration
MONITORING_PROMETHEUS_ENABLED=true
MONITORING_PROMETHEUS_PORT=9090
MONITORING_GRAFANA_ENABLED=true
MONITORING_GRAFANA_PORT=3000
MONITORING_HEALTH_CHECK_INTERVAL=30
MONITORING_HEALTH_CHECK_TIMEOUT=10
MONITORING_ALERTS_ENABLED=true
MONITORING_SLACK_WEBHOOK_URL=
MONITORING_DISCORD_WEBHOOK_URL=