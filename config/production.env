# Production Environment Configuration
# TASK-5: Configuración de variables de entorno

# Environment
ENVIRONMENT=production
DEBUG=false
APP_NAME=AlgoTrading
APP_VERSION=1.0.0

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=algotrading_prod
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_PRODUCTION_PASSWORD
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_SSL_MODE=require
DB_SSL_CERT=
DB_SSL_KEY=
DB_SSL_ROOT_CERT=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
REDIS_SSL=true
REDIS_SSL_CERT_REQS=required

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
SECRET_KEY=CHANGE_ME_PRODUCTION_SECRET_KEY_32_CHARS_MINIMUM
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1
CORS_ORIGINS=["https://yourdomain.com", "https://api.yourdomain.com"]
CORS_METHODS=["GET", "POST", "PUT", "DELETE"]
CORS_HEADERS=["Content-Type", "Authorization"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Trading Configuration
DEFAULT_STRATEGY=momentum
MAX_POSITION_SIZE=0.05
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.10
STOP_LOSS_PERCENTAGE=0.015
TAKE_PROFIT_PERCENTAGE=0.03
POSITION_SIZING_METHOD=risk_based
MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_API_KEY=CHANGE_ME_MARKET_DATA_API_KEY
MARKET_DATA_RATE_LIMIT=100
BROKER_NAME=interactive_brokers
BROKER_API_KEY=CHANGE_ME_BROKER_API_KEY
BROKER_SECRET_KEY=CHANGE_ME_BROKER_SECRET_KEY
BROKER_SANDBOX=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/var/log/algotrading/app.log
LOG_FILE_MAX_SIZE=52428800
LOG_FILE_BACKUP_COUNT=10
LOG_CONSOLE_ENABLED=false
LOG_CONSOLE_LEVEL=WARNING
ELK_ENABLED=true
ELK_HOST=elasticsearch
ELK_PORT=9200
ELK_INDEX=algotrading-prod

# Monitoring Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_PATH=/metrics
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
ALERTS_ENABLED=true
ALERTS_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
ALERTS_EMAIL=alerts@yourdomain.com
