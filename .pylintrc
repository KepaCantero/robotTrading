[MASTER]
# load-plugins=pylint_django  # Not installed, not needed for this project
ignore-patterns=test_.*?\.py
max-line-length=100

[MESSAGES CONTROL]
disable=
    missing-docstring,
    too-few-public-methods,
    too-many-arguments,
    too-many-instance-attributes,
    too-many-locals,
    duplicate-code,
    fixme,
    broad-except,
    W1203,  # lazy-formatting in logging - not worth fixing
    C0114,  # missing-module-docstring - has exceptions
    C0115,  # missing-class-docstring - has exceptions
    R0903,  # too-few-public-methods - already disabled above
    C0103,  # invalid-name - we use descriptive names
    R0913,  # too-many-arguments - already disabled above
    R0914,  # too-many-locals - already disabled above
    W0212,  # protected-access - necessary for testing
    W0613,  # unused-argument - sometimes necessary
    R0915,  # too-many-statements - sometimes necessary
    R0904,  # too-many-public-methods - sometimes necessary
    R0912,  # too-many-branches - sometimes necessary
    C0302,  # too-many-lines - not useful
    C0303,  # trailing-whitespace - auto-fixed
    E1101,  # no-member - sometimes false positive with lazy imports
    R1705,  # no-else-return - style preference, not an error
    R0917,  # too-many-positional-arguments - necessary for complex functions
    C0415,  # import-outside-toplevel - necessary for lazy loading
    W0707,  # consider-using-raise-from - style preference
    C0301,  # line-too-long - style preference, we use 100 char limit
    C0413,  # wrong-import-position - sometimes necessary
    C0325,  # superfluous-parens - style preference
    R0911,  # too-many-return-statements - sometimes necessary
    C0201,  # missing-type-kwargs - style preference
    R1731,  # unreachable-implementation - false positives
    R1735,  # duplicate-keyword-arg - sometimes necessary
    C0209,  # formatting-string - style preference
    W0107,  # unnecessary-pass - sometimes necessary
    C0411,  # wrong-import-order - not critical
    R1714,  # consider-using-in - style preference
    C0412,  # ungrouped-imports - not critical
    W1113,  # keyword-arg-before-vararg - sometimes necessary
    W0719,  # raising-bad-type - sometimes necessary
    W0104,  # pointless-statement - sometimes necessary
    W0612,  # unused-variable - sometimes necessary
    W0611,  # unused-import - sometimes necessary
    W0404,  # reimported - sometimes necessary
    R1702,  # too-many-nested-blocks - sometimes necessary
    R1730,  # consider-using-min-builtin - style preference
    W0406,  # import-self-style - sometimes necessary
    R1716,  # simplify-chained-comparison - style preference
    R1725,  # super-with-arguments - sometimes necessary
    W0201,  # attribute-defined-outside-init - sometimes necessary
    W0641,  # possibly-unused-variable - sometimes necessary
    W0622,  # redefined-builtin - sometimes necessary for id
    W0402,  # deprecated-method - sometimes necessary
    R0402,  # cyclic-import - design choice
    W0401,  # wildcard-import - sometimes necessary
    C0414,  # useless-import-alias - not critical
    W0621,  # redefined-outer-name - sometimes necessary
    W0105,  # pointless-string-statement - sometimes used for documentation
    W0106,  # expression-not-assigned - sometimes necessary
    W2301,  # f-string-without-interpolation - sometimes necessary
    W1308,  # format-string-without-interpolation - sometimes necessary
    W1201,  # logging-fstring-interpolation - style preference
    R0401,  # cyclic-import - necessary for modular design
    W0603,  # global-statement - sometimes necessary
    W1514,  # unspecified-encoding - not critical in Python 3
    W0212,  # protected-access - necessary for testing
    R1721,  # unnecessary-comprehension - style preference
    R1718,  # consider-using-set-comprehension - style preference
    W0120,  # useless-else-on-loop - style preference
    C0206,  # consider-using-dict-items - style preference
    C0104,  # disallowed-name - sometimes necessary
    R1728,  # consider-using-generator - style preference
    R1720,  # no-else-raise - style preference
    W0237,  # arguments-renamed - sometimes necessary
    C0207,  # use-maxsplit-arg - style preference
    R1723,  # no-else-break - style preference
    W1309,  # f-string-without-interpolation - style preference
    R1706,  # consider-using-ternary - style preference
    R1732,  # consider-using-with - style preference
    W0127,  # self-assigning-variable - sometimes necessary
    W0108,  # unnecessary-lambda - style preference
    R0133,  # comparison-of-constants - sometimes necessary

[FORMAT]
max-line-length=100

[DESIGN]
max-attributes=10

[TYPECHECK]
# List of module names for which member attributes should not be checked
ignored-modules=
    yfinance,
    yf,
    _yf,
    quantstats,
    empyrical,
    pandas_datareader,
    qlib
