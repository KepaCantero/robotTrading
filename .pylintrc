[MASTER]
load-plugins=pylint_django
ignore-patterns=test_.*?\.py
max-line-length=100

[MESSAGES CONTROL]
disable=
    missing-docstring,
    too-few-public-methods,
    too-many-arguments,
    too-many-instance-attributes,
    too-many-locals,
    duplicate-code,
    fixme,
    broad-except

[FORMAT]
max-line-length=100

[DESIGN]
max-attributes=10
